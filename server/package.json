{
  "name": "cedarforma-server",
  "version": "1.0.0",
  "private": true,
  "main": "app.js",
  "type": "commonjs",
  "scripts": {
    "start": "NODE_ENV=production node app.js",
    "server": "nodemon app.js",
    "client": "npm run dev --prefix ../client",
    "dev": "cross-env NODE_ENV=development run-p server client",
    "migrate": "NODE_ENV=development npx sequelize-cli db:migrate",
    "migrate:undo": "NODE_ENV=development npx sequelize-cli db:migrate:undo",
    "migrate:undo:all": "NODE_ENV=development npx sequelize-cli db:migrate:undo:all",
    "seed": "NODE_ENV=development npx sequelize-cli db:seed:all"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "sequelize-cli": "^6.6.5"
  }
}
